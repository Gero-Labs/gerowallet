# OS files
.DS_Store
Thumbs.db

# Secrets — never commit private key material.
# APNs signing keys (.p8) and similar live-credential files must stay out of git.
# The .claude/ dir is NOT ignored wholesale (it has tracked docs), so guard the
# credential file types explicitly.
*.p8
*.mobileprovision
# Cloudflare token-policy artifacts (accidentally committed once; policy JSON,
# not a secret, but infra config doesn't belong in the wallet repo).
.cloudflare_api

# Dependencies. Both forms: `node_modules/` only matches a directory, so a
# node_modules SYMLINK (worktree dev setups) would slip past it.
node_modules/
node_modules

# Build outputs
/dist
extension/
*.d.ts
!components.d.ts
!src/types/*.d.ts

# Environment files (keep only .env.example)
.env
.env.*
!.env.example

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Windows temporary files
DumpStack.log
DumpStack.log.tmp
*.tmp
nul

# Editor directories and files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Test coverage
coverage/

# Local cache
.cache/
.eslintcache

# Graphify output
graphify-out/

# Translation utility scripts (temporary)
scripts/translate-*.js
scripts/merge-translations.js
# Catalyst / milestone deliverables + local write-ups (kept local).
# docs/catalyst/ is covered by /docs/ below.
CloseOut_Video_Script.md
Milestone4_Proof_of_Achievement.md
MEDIUM_ARTICLE_*.md
email-templates/

# Exported reports and vendored example bundles. No .docx/.pdf/.rar/.zip is
# tracked anywhere in this repo, so ignore them wholesale rather than by name.
*.docx
*.pdf
*.rar
*.zip

# Per-developer Claude / superpowers state
.claude/
.superpowers/

# Local planning and working documents stay on this machine.
/docs/

# Local MCP config + worktrees must never be committed
.mcp.json.local
.worktrees/
.playwright-mcp
.midnight-expert
