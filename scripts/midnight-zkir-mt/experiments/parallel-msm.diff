+        #[cfg(target_arch = "wasm32")]
+        {
+            use rayon::prelude::*;
+            const MIN_CHUNK: usize = 256;
+            let threads = rayon::current_num_threads();
+            if threads > 1 && points.len() == scalars.len() && points.len() >= 2 * MIN_CHUNK {
+                let chunk = points.len().div_ceil(threads).max(MIN_CHUNK);
