{
  "name": "gero-wallet",
  "displayName": "Gero Dashboard",
  "version": "2.5.4",
  "private": true,
  "description": "A Multi-chain Light Wallet Merging Web2 and Web3",
  "scripts": {
    "dev": "npm run clear && cross-env NODE_ENV=development NODE_OPTIONS='--max-old-space-size=16384 --max-semi-space-size=512' run-p dev:*",
    "dev-firefox": "npm run clear && cross-env NODE_ENV=development EXTENSION=firefox run-p dev:*",
    "dev:prepare": "esno scripts/prepare.ts",
    "dev:background": "npm run build:background -- --mode development",
    "dev:content": "npm run build:content -- --mode development",
    "dev:inject": "npm run build:inject -- --mode development",
    "dev:web": "vite --mode development",
    "build": "npm run clear && cross-env NODE_ENV=production NODE_OPTIONS='--max-old-space-size=16384 --max-semi-space-size=512' VITE_CACHE=true run-p \"build:background -- --mode production\" \"build:content -- --mode production\" \"build:inject -- --mode production\" \"build:web -- --mode production\" && npm run build:prepare",
    "build:beta": "npm run clear && cross-env NODE_ENV=production run-s \"build:background -- --mode beta\" \"build:content -- --mode beta\" \"build:inject -- --mode beta\" \"build:web -- --mode beta\" && npm run build:prepare:beta",
    "build:prepare": "npx cross-env NODE_ENV=production dotenv -e .env.production -- esno scripts/prepare.ts",
    "build:prepare:beta": "npx cross-env NODE_ENV=production dotenv -e .env.beta -- esno scripts/prepare.ts",
    "build:background": "vite build --config vite.config.background.mts",
    "build:web": "vite build --config vite.config.mts",
    "build:content": "vite build --config vite.config.content.mts",
    "build:inject": "vite build --config vite.config.inject.mts",
    "pack": "cross-env NODE_ENV=production run-p pack:*",
    "pack:zip": "rimraf extension/*.zip && jszip-cli add extension/* -o ./extension/Gero-v${npm_package_version}.zip",
    "pack:zip:beta": "rimraf extension/*.zip && jszip-cli add extension/* -o ./extension/Gero-v${npm_package_version}-Beta.zip",
    "pack:crx": "crx pack extension -o ./extension.crx",
    "pack:xpi": "cross-env WEB_EXT_ARTIFACTS_DIR=./ web-ext build --source-dir ./extension --filename extension.xpi --overwrite-dest",

    "start:chromium": "web-ext run --source-dir ./extension --target=chromium",
    "start:firefox": "web-ext run --source-dir ./extension --target=firefox-desktop",
    "clear": "rimraf --glob extension/assets extension/background extension/content extension/index.html extension/manifest.json",
    "lint": "eslint --cache .",
    "test": "vitest test",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bringweb3/chrome-extension-kit": "^1.4.4",
    "@cardano-foundation/cardano-verify-datasignature": "^1.0.11",
    "@cardano-foundation/ledgerjs-hw-app-cardano": "^7.1.4",
    "@cardano-sdk/core": "^0.46.2",
    "@cardano-sdk/tx-construction": "^0.27.4",
    "@emurgo/cardano-message-signing-browser": "^1.1.0",
    "@emurgo/cardano-serialization-lib-browser": "^12.1.0",
    "@emurgo/cip14-js": "^3.0.1",
    "@keystonehq/keystone-sdk": "^0.8.0",
    "@ledgerhq/hw-transport-web-ble": "^6.29.2",
